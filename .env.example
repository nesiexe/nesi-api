# Server
NODE_ENV=production
SERVER_PORT=3002
SERVER_HOST=0.0.0.0

# Private Spotify auth app (only needed during initial authorization)
PRIVATE_APP_PORT=3003
PRIVATE_APP_HOST=0.0.0.0
SPOTIFY_REDIRECT_URI=

# CORS - comma separated origins (e.g. https://nesiexe.xyz)
CORS_ORIGINS=https://nesiexe.xyz

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Barq integration
BARQ_API_KEY=
BARQ_ALLOWED_UUIDS=
BARQ_DEFAULT_UUID=
