# Server
NODE_ENV=production
SERVER_PORT=3002
SERVER_HOST=0.0.0.0
# Required in production: actual proxy IPs/CIDRs, or empty for direct access.
# No wildcard networks; only trust proxies you control.
TRUSTED_PROXIES=

# Private Spotify auth app (only needed during initial authorization)
PRIVATE_APP_PORT=3003
PRIVATE_APP_HOST=127.0.0.1
# Empty disables the auth server. Use a random password of 32-256 characters.
SPOTIFY_AUTH_PASSWORD=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3003/api/callback

# CORS - comma separated origins (e.g. https://nesiexe.xyz)
CORS_ORIGINS=https://nesiexe.xyz

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Dedicated private directory, owned by the runtime user (0700); token file is 0600.
SPOTIFY_TOKEN_FILE=.secrets/spotify-refresh-token

# Barq integration
BARQ_API_KEY=
# Required for profile access: empty denies all; include BARQ_DEFAULT_UUID here too.
BARQ_ALLOWED_UUIDS=
BARQ_DEFAULT_UUID=

# GitHub stats: one expiring classic personal access token for all stats.
GITHUB_USERNAME=nesiexe
GITHUB_TOKEN=
# Add http://localhost:4000 to CORS_ORIGINS for the local portfolio.
